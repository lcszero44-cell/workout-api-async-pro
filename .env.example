# ==============================================================================
# Workout API Async Pro — Environment Configuration
# ==============================================================================
# Por padrão, utiliza SQLite Assíncrono (Zero-Config, funciona sem Docker/Postgres).
# Para produção ou Docker Compose com PostgreSQL, altere DATABASE_URL abaixo.

APP_NAME="Workout API Async Pro"
APP_VERSION="2.0.0"
APP_ENV="development"
DEBUG=true

# Opção 1 (Padrão Plug-and-Play — Zero-Config):
DATABASE_URL="sqlite+aiosqlite:///./workout.db"

# Opção 2 (Produção / Docker Compose — PostgreSQL Assíncrono):
# DATABASE_URL="postgresql+asyncpg://workout:workout@localhost:5432/workout"

# Auto-Seed inteligente no startup caso o banco esteja vazio
AUTO_SEED=true

# Servidor Uvicorn
HOST="127.0.0.1"
PORT=8000
